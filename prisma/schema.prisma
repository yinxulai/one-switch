generator client {
  provider = "prisma-client"
  output   = "../source/server/database/client"
}

datasource db {
  provider = "sqlite"
}

model Provider {
  id                  String           @id
  name                String
  apiKeyReference     String
  timeoutMilliseconds Int              @default(30000)
  enabled             Boolean          @default(true)
  createdTime         BigInt
  updatedTime         BigInt
  deletedTime         BigInt?
  bindings            ModelBinding[]
  health              ProviderHealth?
  attempts            RequestAttempt[]

  @@index([deletedTime], map: "idx_providers_deleted_time")
  @@map("providers")
}

model LogicalModel {
  id          String         @id
  name        String
  description String         @default("")
  enabled     Boolean        @default(true)
  createdTime BigInt
  updatedTime BigInt
  deletedTime BigInt?
  bindings    ModelBinding[]

  @@index([name], map: "idx_logical_models_name")
  @@index([deletedTime], map: "idx_logical_models_deleted_time")
  @@map("logical_models")
}

model ModelBinding {
  id               String           @id
  logicalModelId   String
  providerId       String
  protocol         String
  upstreamUrl      String
  upstreamModelId  String
  priority         Int
  enabled          Boolean          @default(true)
  customAuthHeader String?
  createdTime      BigInt
  updatedTime      BigInt
  deletedTime      BigInt?
  logicalModel     LogicalModel     @relation(fields: [logicalModelId], references: [id])
  provider         Provider         @relation(fields: [providerId], references: [id])
  attempts         RequestAttempt[]

  @@index([logicalModelId, priority], map: "idx_bindings_logical_model_priority")
  @@index([providerId], map: "idx_bindings_provider")
  @@index([protocol], map: "idx_bindings_protocol")
  @@index([deletedTime], map: "idx_bindings_deleted_time")
  @@map("model_bindings")
}

model ProviderHealth {
  providerId          String   @id
  consecutiveFailures Int      @default(0)
  cooldownUntilTime   BigInt?
  lastSuccessTime     BigInt?
  lastFailureTime     BigInt?
  updatedTime         BigInt
  provider            Provider @relation(fields: [providerId], references: [id])

  @@map("provider_health")
}

model Settings {
  id                          String  @id
  listenHost                  String  @default("127.0.0.1")
  listenPort                  Int     @default(9300)
  accessTokenReference        String?
  logRetentionCount           Int     @default(1000)
  cooldownBaseSeconds         Int     @default(30)
  cooldownMaxSeconds          Int     @default(300)
  consecutiveFailureThreshold Int     @default(3)
  idleTimeoutMilliseconds     Int     @default(30000)
  updatedTime                 BigInt

  @@map("settings")
}

model RequestLog {
  id                        String           @id
  logicalModelId            String
  protocol                  String
  status                    String
  totalDurationMilliseconds Int
  totalTokens               Int?
  createdTime               BigInt
  attempts                  RequestAttempt[]

  @@index([createdTime], map: "idx_request_logs_created_time")
  @@index([status], map: "idx_request_logs_status")
  @@map("request_logs")
}

model RequestAttempt {
  id                   String       @id
  requestId            String
  providerId           String
  bindingId            String
  upstreamModelId      String
  attemptIndex         Int
  status               String
  errorCode            String?
  errorMessage         String?
  durationMilliseconds Int
  createdTime          BigInt
  request              RequestLog   @relation(fields: [requestId], references: [id])
  provider             Provider     @relation(fields: [providerId], references: [id])
  binding              ModelBinding @relation(fields: [bindingId], references: [id])

  @@index([requestId], map: "idx_attempts_request_id")
  @@index([providerId], map: "idx_attempts_provider")
  @@index([createdTime], map: "idx_attempts_created_time")
  @@map("request_attempts")
}
