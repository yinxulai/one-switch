{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    // 别名保留 S0 之前的名字（`@common` / `@server` / `@render` / `@`），只把目标改到 `source/`。
    // 改名会同时动上千处 import 和 `product/*.md` 里的说明，却换不来任何能力，不做。
    "paths": {
      "@/*": ["packages/console/source/*"],
      "@common/*": ["packages/contracts/source/*"],
      "@server/*": ["packages/core/source/*"],
      "@render/*": ["packages/console/*"]
    }
  },
  "include": [
    "packages/contracts/source/**/*.ts",
    "packages/core/source/**/*.ts",
    "packages/console/source/**/*.ts",
    "packages/console/source/**/*.tsx",
    "apps/app/source/**/*.ts"
  ]
}
